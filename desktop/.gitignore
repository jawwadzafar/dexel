# Sidecar binaries are BUILD ARTIFACTS produced by scripts/build-sidecar.sh
# (each ~10MB, one per target triple). They are what `bundle.externalBin`
# points at, but they are never committed — run the script before building.
/src-tauri/binaries/

# Cargo/Tauri build output. src-tauri declares its own [workspace], so its
# target/ dir is here rather than at the repo root.
/src-tauri/target/

# Generated by tauri-build on every build: the ACL schemas the capability
# files' $schema points at, plus the generated permission/capability code.
/src-tauri/gen/
